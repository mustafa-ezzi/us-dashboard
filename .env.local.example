# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Web Push — run: npx web-push generate-vapid-keys
# Public key is safe in the browser; private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com

# Cron job auth (random string; same in cron-job.org header)
CRON_SECRET=your-random-cron-secret-here
CRON_TIMEZONE=Asia/Karachi

# Birthday splash — shows every app open. Set to false after her birthday, then redeploy.
NEXT_PUBLIC_BIRTHDAY_SPLASH=true

# Engagement construction lock (24 Jul 11pm → 25 Jul 8pm Asia/Karachi)
# Keep preview on for everyone until the real window / unlock:
NEXT_PUBLIC_ENGAGEMENT_LOCK_PREVIEW=true
# Permanent skip on your machine only while coding (optional):
# NEXT_PUBLIC_ENGAGEMENT_LOCK_BYPASS=true
